FEEDLENS_HOME=~/.feedlens
FEEDLENS_HOST=127.0.0.1
FEEDLENS_PORT=8765
FEEDLENS_DECISION_BACKEND=ollama          # ollama | typesafe | fake
FEEDLENS_OLLAMA_URL=http://127.0.0.1:11434
FEEDLENS_DECISION_MODEL=qwen3.5:4b
FEEDLENS_EMBED_MODEL=qwen3-embedding:0.6b
FEEDLENS_REFRESH_INTERVAL_MIN=15
FEEDLENS_SCHEDULER=on
# TYPESAFE_API_KEY=            # only if FEEDLENS_DECISION_BACKEND=typesafe
